#!/usr/bin/env bash
# Launcher for the PacBio IsoSeq pipeline; shared logic is in bin/launcher.sh (copied from biowulf-snakemake-launcher).
# shellcheck disable=SC2034  # variables below are read by launcher.sh

PIPELINE_NAME="IsoSeq"
PIPELINE_DESCRIPTION="run the PacBio IsoSeq pipeline"
PIPELINE_SBATCH_SETUP='source myconda || { echo "ERROR: myconda not found; the isoseq conda environment is required" >&2; exit 1; }
mamba activate isoseq || { echo "ERROR: could not activate the isoseq conda environment" >&2; exit 1; }'

PIPELINE_HOME="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
if [[ ! -f "${PIPELINE_HOME}/bin/launcher.sh" ]]; then
  echo "ERROR: ${PIPELINE_HOME}/bin/launcher.sh not found." >&2
  exit 1
fi
# shellcheck source=/dev/null
source "${PIPELINE_HOME}/bin/launcher.sh"
main "$@"
